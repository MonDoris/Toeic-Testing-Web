<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Công cụ đóng gói đề mẫu: đọc samples/<gói>/test.json, tự tạo audio (giọng đọc Windows, xuất MP3)
    và ảnh (tranh Part 1, biểu đồ Part 3/4 – vẽ bằng Microsoft Edge headless) cho các file media còn thiếu,
    kiểm tra gói bằng chính bộ validate của TestImportService rồi nén thành .zip trong Seed/samples.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToeicPractice.Application\ToeicPractice.Application.csproj" />
  </ItemGroup>

</Project>
